{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["ES2019", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "../assets/scripts/canvas/**/*.ts",
    "../assets/scripts/IPainter.ts",
    "../assets/scripts/ITextLayer.ts",
    "../assets/scripts/Sprites.ts",
    "../assets/scripts/core/**/*.ts"
  ]
}
